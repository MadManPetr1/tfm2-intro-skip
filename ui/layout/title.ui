      }
    }

    #quit:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";

      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.quit";
      }
    }
