  #host_saved_tooltip_hitbox:color {
    x: 1121px;
    y: 480px;
    width: 608px;
    height: 50px;
    visible: false;
    color: #00000000;
  }

  #host_saved_tooltip:color {
    z: 101;
    visible: false;
    ignore_event: true;
    height: 42px;
    width: 550px;
    back_color: #161721ff;
    color: #4a4c56ff;
    stroke: 1;
    rounding: Uniform {
      rounding: 8;
    }
    padding: {
      left: 10px;
      right: 10px;
      top: 5px;
      bottom: 5px;
    }

    #text:label {
      @"asset/base/style/main#label";
      z: 101;
      size: 18;
      text: "#asset/base/text/ui?title.mp_host_saved_empty_tooltip";
      align_x: Center;
      align_y: Center;
    }
  }

  #version:label {
    @"asset/base/style/main#label";

    anchor_x: 1;
    pivot_x: 1;
    anchor_y: 1;
    pivot_y: 1;
    size: 18;

    width: 300px;

    align_x: Right;
    align_y: Bottom;
    text: "Version";

    x: -60px;
    y: -60px;
  }

  #discord:color_icon_button {
    @"asset/base/style/main#tertiary_button";

    anchor_x: 1;
    pivot_x: 1;
    anchor_y: 1;
    pivot_y: 1;

    width: 40px;
    height: 40px;

    x: -60px;
    y: -100px;

    icon: {
      source: "asset/base/ui/icons/discord";
      rect: {
        x: 8;
        y: 8;
        w: 24;
        h: 24;
      }
    }
  }

  #fade:color_icon_button {
    width: 100%;
    height: 100%;

    btn: {
      color: #60708540;
    }

    visible: false;
  }

  #mods_popup:color {
    width: 1532px;
    height: 886px;

    anchor_x: 0.5;
    pivot_x: 0.5;
    anchor_y: 0.5;
    pivot_y: 0.5;

    visible: false;

    color: #161721ff;

    rounding: Uniform {
      rounding: 12;
    }

    #header:empty {
      width: 1532px;
      height: 56px;

      #title:label {
        @"asset/base/style/main#bold_label";

        width: 400px;
        height: 56px;

        size: 18;

        align_y: Center;
        text: "#asset/base/text/ui?mods.title";

        x: 24px;
      }

      #cancel:button {
        width: 16px;
        height: 16px;

        anchor_x: 1;
        pivot_x: 1;

        x: -24px;
        y: 20px;

        source: "asset/base/ui/icons/cross";

        color: #c2c6ceff;

        hover: {
          color: #e8e8e8ff;
        }

        active: {
          color: #e8e8e8ff;
        }
      }
    }

    #left_panel:empty {
      x: 24px;
      y: 68px;
      width: 770px;
      height: 702px;

      #table:empty {
        width: 770px;
        height: 702px;

        #table_header:empty {
          width: 770px;
          height: 56px;

          #name:label {
            @"asset/base/style/main#label";
            width: 300px;
            height: 56px;

            x: 12px;

            align_x: Left;
            align_y: Center;
            size: 16;

            text: "#asset/base/text/ui?mods.header_name";
          }

          #author:label {
            @"asset/base/style/main#label";
            width: 220px;
            height: 56px;

            x: 312px;

            align_x: Left;
            align_y: Center;
            size: 16;

            text: "#asset/base/text/ui?mods.header_author";
          }

          #active:label {
            @"asset/base/style/main#label";
            width: 214px;
            height: 56px;

            x: 532px;

            align_x: Left;
            align_y: Center;
            size: 16;

            text: "#asset/base/text/ui?mods.header_active";
          }
        }

        #contents:scroll_view {
          width: 770px;
          height: 646px;

          y: 56px;

          speed: 100;
          bar_width: 4;

          bar: {
            source: "asset/base/sprite/white";
            color: #37d5b3ff;
            hover: {
              color: #ecfbf8ff;
            }
          }

          back: {
            source: "asset/base/sprite/white";
            color: #4a4c56ff;
          }

          #contents:empty {
            x: 2px;
            y: 8px;
            width: 758px;
            height: auto;

            child_type: TopToBottom {
              spacing: 8px;
            }
          }
        }
      }

      #no_mods:label {
        @"asset/base/style/main#label";
        width: 770px;
        height: 702px;

        align_x: Center;
        align_y: Center;
        size: 16;

        text: "#asset/base/text/ui?mods.no_mods";
      }
    }

    #right_panel:empty {
      x: 808px;
      y: 68px;
      width: 700px;
      height: 702px;

      #top:empty {
        width: 700px;
        height: 120px;

        #thumbnail_panel:color {
          width: 120px;
          height: 120px;

          color: #252738ff;

          rounding: Uniform {
            rounding: 8;
          }

          #thumbnail:image {
            x: 10px;
            y: 10px;
            width: 100px;
            height: 100px;

            source: "";
          }
        }

        #info_panel:color {
          x: 134px;
          width: 566px;
          height: 120px;

          color: #252738ff;

          rounding: Uniform {
            rounding: 8;
          }

          #mod_name:label {
            @"asset/base/style/main#bold_label";
            x: 16px;
            y: 12px;
            width: 534px;
            height: 32px;

            align_x: Left;
            align_y: Center;
            size: 24;

            text: "-";
          }

          #mod_author:label {
            @"asset/base/style/main#label";
            x: 16px;
            y: 48px;
            width: 534px;
            height: 24px;

            align_x: Left;
            align_y: Center;
            size: 16;

