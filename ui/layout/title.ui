            height: 24px;
            visible: false;

            align_x: Right;
            align_y: Center;
            size: 14;
            color: #a3a9b6ff;
            text: "Requires base >=0.5.2, <0.5.4";
          }
        }
      }

      #description_panel:color {
        y: 134px;
        width: 700px;
        height: 440px;

        color: #252738ff;

        rounding: Uniform {
