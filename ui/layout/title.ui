  #credits_screen:empty {
    width: 100%;
    height: 100%;
    visible: false;

    #playback_overlay:color {
      x: 60px;
      y: 60px;
      width: 870px;
      height: 960px;

      color: #60708540;

      rounding: Uniform {
        rounding: 8;
      }
    }

    #credits_scroll:scroll_view {
      x: 110px;
      y: 150px;
      width: 770px;
      height: 780px;

      speed: 90;
      bar_width: 0;

      bar: {
        source: "asset/base/sprite/white";
        color: #37d5b3ff;
        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 746px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }

        #credits_text:label {
          @"asset/base/style/main#label";

          width: 746px;
          height: 10000px;

          size: 18;
          line_height: 28;
          color: #f4f7fbff;
          outline: 2;
          outline_color: #05070bcc;

          align_x: Left;
          align_y: Top;
          fit_height: true;
          ratio: 0;
          text_sound: "asset/base/sound/sfx/text_typing";
          text: "";
        }
      }
    }

    #back:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";

      x: 1121px;
      y: 410px;
      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.mp_back";
      }
    }
  }

  #multiplayer_buttons:empty {
    width: 608px;
    height: 470px;
    x: 1121px;
    y: 410px;
    visible: false;

    child_type: TopToBottom {
      spacing: 20px;
    }

    #host_new:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
