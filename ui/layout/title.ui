            }

            #description_text:label {
              @"asset/base/style/main#label";
              width: 652px;
              height: 10000px;

              align_x: Left;
              align_y: Top;
              size: 16;
              line_height: 24;

              fit_height: true;

              text: "#asset/base/text/ui?mods.no_selection";
            }
          }
        }
      }

      #intro_skip_settings:color {
        y: 134px;
        width: 700px;
        height: 568px;
        z: 10;
        visible: false;

        color: #252738ff;

        rounding: Uniform {
          rounding: 8;
        }

        #intro_skip_settings_title:label {
          @"asset/base/style/main#bold_label";
          x: 20px;
          y: 16px;
          width: 660px;
          height: 28px;

          align_x: Left;
          align_y: Center;
          size: 20;
          text: "Startup automation";
        }

