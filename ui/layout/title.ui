      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.mods";
      }
    }

    #database_edit:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";

      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.database_edit";
      }
    }

    #options:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";

      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.options";
      }
    }

    #credit:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";

      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
