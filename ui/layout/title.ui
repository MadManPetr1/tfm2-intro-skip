body:color {
  width: 100%;
  height: 100%;

  color: #0f101600;

  #logo:image {
    width: 608px;
    height: 158px;

    x: 1121px;
    y: 152px;

    source: "asset/base/sprite/logo";
  }

  #icon:image {
    width: 12px;
    height: 6px;

    color: #4a4c56ff;
    source: "asset/base/ui/icons/down_arrow";

    x: 1425px;
    y: 360px;

    pivot_x: 0.5;
    pivot_y: 0.5;
  }

  #line1:color {
    width: 288px;
    height: 1px;
    x: 1121px;
    y: 360px;

    color: #4a4c56ff;
  }

  #line2:color {
    width: 288px;
    height: 1px;
    x: 1441px;
    y: 360px;

    color: #4a4c56ff;
  }

  #buttons:empty {
    width: 608px;
    height: 540px;
    x: 1121px;
    y: 410px;

    child_type: TopToBottom {
      spacing: 20px;
    }

    #continue:bouncing_color_icon_button {
      @"asset/base/style/main#secondary_button";
      @"asset/base/style/effect#bouncing";
      visible: false;

      width: 608px;
      height: 50px;
      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.continue";
      }
    }

    #load:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";
      visible: false;

      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.load";
      }
    }

    #new_game:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
      @"asset/base/style/effect#bouncing";

      width: 608px;
      height: 50px;

      text: {
        align_x: Center;
        align_y: Center;
        size: 18;
        text: "#asset/base/text/ui?title.new_game";
      }
    }

    #multiplayer:bouncing_color_icon_button {
      @"asset/base/style/main#tertiary_button";
